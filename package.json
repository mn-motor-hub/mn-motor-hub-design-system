{
  "name": "@mn/design-system",
  "version": "1.3.0",
  "description": "Design system de MN Motor Hub — tokens compartidos entre la tienda web, el ERP interno y la generación de contenido de marca.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tokens",
    "docs"
  ],
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./recipes.css": "./dist/recipes.css",
    "./tokens.json": "./dist/tokens.json",
    "./source": "./tokens/tokens.json"
  },
  "scripts": {
    "build": "node tokens/build.mjs",
    "check": "node tokens/build.mjs && git diff --exit-code -- dist docs/BRAND.md",
    "prepare": "node tokens/build.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mn-motor-hub/mn-motor-hub-design-system.git"
  }
}
