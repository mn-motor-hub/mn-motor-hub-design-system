{
  "version": "1.2.0",
  "name": "MN Motor Hub Design System",

  "_comment": [
    "FUENTE DE VERDAD UNICA. Todo en dist/ es generado desde este archivo.",
    "No editar dist/ a mano: se sobrescribe en cada `npm run build`.",
    "Convencion: un string es un token; un objeto es un grupo.",
    "La clave DEFAULT toma el nombre del grupo (color.primary.DEFAULT -> --color-primary).",
    "Una referencia se escribe {ruta.al.token} y se resuelve en build."
  ],

  "tokens": {
    "color": {
      "background": "#131313",

      "surface": {
        "DEFAULT": "{color.surface.container}",
        "lowest": "#0e0e0e",
        "low": "#1c1b1b",
        "container": "#201f1f",
        "high": "#2a2a2a",
        "variant": "#353534"
      },

      "primary": {
        "DEFAULT": "#ff571a",
        "hover": "#d63f00",
        "dim": "#ffb59e",
        "dim-hover": "#e6a08c"
      },
      "on-primary": "#521300",

      "on-surface": {
        "DEFAULT": "#e5e2e1",
        "variant": "#e6beb2"
      },

      "outline": {
        "DEFAULT": "#ad897e",
        "variant": "#5c4037"
      },

      "success": { "DEFAULT": "#4caf7d", "dim": "rgba(76, 175, 125, 0.12)" },
      "warning": { "DEFAULT": "#f0a845", "dim": "rgba(240, 168, 69, 0.12)" },
      "danger":  { "DEFAULT": "#f05252", "dim": "rgba(240, 82, 82, 0.12)", "hover": "#c53030" },
      "on-danger": "#2e0000",
      "info":    { "DEFAULT": "#4da6ff", "dim": "rgba(77, 166, 255, 0.12)" },

      "bg": "{color.background}",
      "accent": "{color.primary.dim}",
      "accent-hover": "{color.primary.dim-hover}",
      "border": "{color.outline.variant}",
      "text": "{color.on-surface}",
      "text-muted": "{color.outline}"
    },

    "overlay": {
      "scrim": "rgba(14, 14, 14, 0.95)",
      "strong": "rgba(14, 14, 14, 0.6)",
      "soft": "rgba(14, 14, 14, 0.4)",
      "primary": "rgba(255, 87, 26, 0.3)",
      "accent": "rgba(255, 181, 158, 0.12)",
      "accent-border": "rgba(255, 181, 158, 0.25)",
      "surface": "rgba(229, 226, 225, 0.08)",
      "border": "rgba(92, 64, 55, 0.3)"
    },

    "font": {
      "oswald": "'Oswald', sans-serif",
      "inter": "'Inter', sans-serif",
      "mono": "'JetBrains Mono', monospace",
      "sans": "{font.inter}",
      "display": "{font.oswald}"
    },

    "text": {
      "2xs": "0.625rem",
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "2rem",
      "4xl": "2.5rem",
      "5xl": "3rem",
      "6xl": "4rem",
      "display": "7.5rem"
    },

    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "extrabold": "800"
    },

    "tracking": {
      "tight": "-0.02em",
      "normal": "0",
      "wide": "0.05em",
      "wider": "0.08em",
      "widest": "0.1em"
    },

    "leading": {
      "tight": "1.1",
      "snug": "1.3",
      "normal": "1.6"
    },

    "space": {
      "2xs": "2px",
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px",
      "2xl": "48px",
      "3xl": "64px"
    },

    "layout": {
      "edge": "clamp(16px, 5vw, 72px)",
      "section": "80px",
      "container-max": "1280px"
    },

    "radius": {
      "sm": "2px",
      "md": "4px",
      "lg": "8px",
      "full": "9999px"
    },

    "shadow": {
      "sm": "0 1px 4px rgba(0, 0, 0, 0.45)",
      "md": "0 4px 16px rgba(0, 0, 0, 0.55)",
      "lg": "0 8px 32px rgba(0, 0, 0, 0.65)"
    },

    "touch": {
      "min": "44px"
    },

    "breakpoint": {
      "sm": "480px",
      "md": "768px",
      "lg": "1280px"
    }
  },

  "recipes": {
    "_comment": "Combinaciones tipograficas recurrentes. Generan clases .mn-* en dist/recipes.css y quedan documentadas para diseno y contenido.",

    "heading": {
      "description": "Titulo de seccion. La firma visual de la marca.",
      "font-family": "{font.oswald}",
      "font-weight": "{weight.bold}",
      "letter-spacing": "{tracking.wide}",
      "line-height": "{leading.tight}",
      "text-transform": "uppercase"
    },
    "subheading": {
      "description": "Titulo secundario, dentro de cards y bloques.",
      "font-family": "{font.oswald}",
      "font-weight": "{weight.semibold}",
      "letter-spacing": "{tracking.wide}",
      "line-height": "{leading.snug}",
      "text-transform": "uppercase"
    },
    "label": {
      "description": "Etiqueta pequena. Badges, overlines, estados.",
      "font-family": "{font.inter}",
      "font-size": "{text.2xs}",
      "font-weight": "{weight.bold}",
      "letter-spacing": "{tracking.widest}",
      "text-transform": "uppercase"
    },
    "button": {
      "description": "Texto de accion.",
      "font-family": "{font.inter}",
      "font-weight": "{weight.semibold}",
      "letter-spacing": "{tracking.wider}",
      "text-transform": "uppercase"
    },
    "body": {
      "description": "Texto corrido.",
      "font-family": "{font.inter}",
      "font-weight": "{weight.regular}",
      "letter-spacing": "{tracking.normal}",
      "line-height": "{leading.normal}"
    },
    "price": {
      "description": "Precio de producto. Siempre en naranja.",
      "font-family": "{font.oswald}",
      "font-weight": "{weight.bold}",
      "letter-spacing": "{tracking.normal}",
      "color": "{color.primary}"
    },
    "data": {
      "description": "Codigos de parte, SKU, cifras en tablas.",
      "font-family": "{font.mono}",
      "font-weight": "{weight.medium}",
      "letter-spacing": "{tracking.normal}"
    }
  },

  "meta": {
    "_comment": "Descripciones de rol. Alimentan la guia de marca generada.",

    "color.primary": "Naranja de accion. CTAs, precios, acentos. El color de la marca.",
    "color.primary.hover": "Naranja en hover/pressed.",
    "color.primary.dim": "Durazno. Texto e iconos de acento sobre fondo oscuro. Nunca como fondo de boton.",
    "color.primary.dim-hover": "Durazno en hover.",
    "color.on-primary": "Marron oscuro. Unico color de texto aprobado sobre el naranja.",
    "color.background": "Fondo de pagina.",
    "color.surface.lowest": "Fondo hundido. Base de overlays sobre foto.",
    "color.surface.low": "Seccion alternada.",
    "color.surface.container": "Card, panel, modal.",
    "color.surface.high": "Elemento elevado. Hover de card.",
    "color.surface.variant": "Separador, fondo de input.",
    "color.on-surface": "Texto principal.",
    "color.on-surface.variant": "Texto secundario, de tono calido.",
    "color.outline": "Borde visible, texto atenuado.",
    "color.outline.variant": "Borde sutil.",
    "color.success": "Confirmado, en stock, pagado.",
    "color.warning": "Stock bajo, pendiente.",
    "color.danger": "Error, sin stock, anulado.",
    "color.danger.hover": "Rojo en hover/pressed de acciones destructivas.",
    "color.on-danger": "Unico color de texto aprobado sobre el rojo solido (5.5:1). Marron oscuro, no negro puro, para no cortar con la paleta calida.",
    "color.info": "Informativo, neutro.",

    "font.oswald": "Titulos y display. Siempre en mayusculas.",
    "font.inter": "Cuerpo, labels, descripciones.",
    "font.mono": "Codigos de parte y cifras alineadas.",

    "touch.min": "Minimo de area tactil. No es espaciado: no redondear a la escala.",
    "layout.edge": "Padding lateral de pagina, fluido entre mobile y desktop."
  }
}
